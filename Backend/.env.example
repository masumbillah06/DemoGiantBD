# ====================================================================
# Giant BD ERP Backend Environment Configuration Template
# ====================================================================

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3005,http://localhost:3000

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/nestdb?schema=public"

# Postgres credentials used by docker-compose.yaml (postgres container + backend DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nestdb

# JWT Authentication Secrets (Generate secure 256-bit random keys in production)
JWT_ACCESS_SECRET="your-secure-jwt-access-secret"
JWT_REFRESH_SECRET="your-secure-jwt-refresh-secret"
JWT_ACCESS_EXPIRE="15m"
JWT_REFRESH_EXPIRE="30d"

# Optional SMTP Email Configuration
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Giant BD ERP Security <no-reply@giantbd.com>"

# Used by docker-compose.yaml for the frontend container (baked into its client bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
